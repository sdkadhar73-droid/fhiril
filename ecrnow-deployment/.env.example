# Copy to .env and replace every placeholder before deployment.
# Paths resolve relative to this deployment directory unless absolute.
ECRNOW_SOURCE_DIR=../../onix/eCRNow/eCRNow
ECRNOW_ARTIFACTS_DIR=../../onix/eCRNow/eCRNow/documents/app-artifacts
ECRNOW_KARS_DIR=../../onix/eCRNow/eCRNow/documents/app-artifacts/kars
ECRNOW_XSD_FILE=../../onix/eCRNow/eCRNow/src/test/resources/AppData/Schema/infrastructure/cda/CDA_SDTC.xsd
ECRNOW_QUERY_DIR=../../onix/eCRNow/eCRNow/src/main/resources/custom-queries
ECRNOW_HOST_PORT=8081

# Keep the database name, username and password consistent across both services.
ECRNOW_DB_NAME=REPLACE_WITH_DATABASE_NAME
ECRNOW_DB_USER=REPLACE_WITH_DATABASE_USER
ECRNOW_DB_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

# Supply a locally generated application key; do not commit .env.
ECRNOW_SECURITY_KEY=REPLACE_WITH_LOCAL_SECURITY_KEY
